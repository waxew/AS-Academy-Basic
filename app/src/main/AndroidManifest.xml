<?xml version="1.0" encoding="utf-8"?>
<!-- Basic uses a single Compose activity; reusable screens and navigation are supplied by AS-Academy-Core. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13+ requests this permission at runtime only when the user enables study reminders. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="Basic"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- MainActivity is the only launcher entry point for the course host. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
